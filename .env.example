# Vercel Connect connector UIDs. The deploy button provisions and sets both;
# for manual setup, create them with `vercel connect create` and paste the UIDs.
GITHUB_CONNECTOR=github/foreman-agent
LINEAR_CONNECTOR=linear/foreman-agent

# MCP connection connectors (Vercel Connect UIDs, not secrets). Catalog
# services: `vercel connect create <service> --connection-method mcp`; others
# by URL: `vercel connect create <mcp-url> --name <name>`. Each needs a
# one-time consent: `vercel connect token <uid> --yes`.
VERCEL_MCP_CONNECTOR=mcp.vercel.com/acquisity-foreman
SENTRY_MCP_CONNECTOR=sentry/acquisity-foreman-sentry
STRIPE_MCP_CONNECTOR=stripe/acquisity-foreman-stripe
POSTHOG_MCP_CONNECTOR=posthog/acquisity-foreman-posthog
PLANETSCALE_MCP_CONNECTOR=planetscale/acquisity-foreman-planetscale
RESEND_MCP_CONNECTOR=resend/acquisity-foreman-resend
EXA_MCP_CONNECTOR=mcp.exa.ai/acquisity-foreman-exa
AXIOM_MCP_CONNECTOR=mcp.axiom.co/acquisity-foreman-axiom
JAM_MCP_CONNECTOR=mcp.jam.dev/acquisity-foreman-jam
INTERCOM_MCP_CONNECTOR=intercom/foreman
MODEM_MCP_CONNECTOR=mcp.modem.dev/acquisity-foreman-modem
NEON_MCP_CONNECTOR=mcp.neon.tech/acquisity-foreman-neon
SUPERMEMORY_MCP_CONNECTOR=mcp.supermemory.ai/acquisity-foreman-supermemory

# Lucent MCP authenticates with a static MCP token (created in Lucent
# organization settings) held by a Connect api-key connector.
LUCENT_MCP_CONNECTOR=app.lucenthq.com/acquisity-foreman-lucent

# Inngest Cloud MCP authenticates with an API key (created at
# https://app.inngest.com/mcp/setup) held by a Connect api-key connector,
# created in the Connect dashboard: API Key type, service api.inngest.com/mcp.
INNGEST_MCP_CONNECTOR=api.inngest.com/acquisity-foreman-inngest

# The repository the factory works on, as owner/repo. Required at build time;
# a missing value fails discovery with a clear error.
FACTORY_REPO=acme/widgets

# Optional: runs inside the station sandboxes' clone once per template build,
# so sessions start with dependencies installed and the repo's checks runnable.
# FACTORY_SETUP_COMMAND="pnpm install"

# Optional overrides; every one has a sensible default.
# FACTORY_LABEL="factory"            # the label that hands an issue to the factory
# FACTORY_BRANCH_PREFIX="factory/"   # branch prefix marking the factory's own PRs
# FACTORY_BOT_NAME=""                # @mention name; defaults to the GitHub App's own slug via the connector
