# Vercel Connect connector UIDs. The deploy button provisions and sets both;
# for manual setup, create them with `vercel connect create` and paste the UIDs.
GITHUB_CONNECTOR=github/foreman-agent
LINEAR_CONNECTOR=linear/foreman-agent

# User-scoped MCP connection connectors (Vercel Connect UIDs, not secrets). Catalog
# services: `vercel connect create <service> --connection-method mcp`; others
# by URL: `vercel connect create <mcp-url> --name <name>`. Each needs a
# one-time consent: `vercel connect token <uid> --yes`.
AUTUMN_MCP_CONNECTOR=mcp.useautumn.com/acquisity-foreman-autumn
AXIOM_MCP_CONNECTOR=mcp.axiom.co/acquisity-foreman-axiom
EXA_MCP_CONNECTOR=mcp.exa.ai/acquisity-foreman-exa
JAM_MCP_CONNECTOR=mcp.jam.dev/acquisity-foreman-jam
MODEM_MCP_CONNECTOR=mcp.modem.dev/acquisity-foreman-modem
NEON_MCP_CONNECTOR=mcp.neon.tech/acquisity-foreman-neon
OPENROUTER_MCP_CONNECTOR=mcp.openrouter.ai/acquisity-foreman-openrouter
PLANETSCALE_MCP_CONNECTOR=planet-scale-read-only-foreman/acquisity-foreman-planet-scale
POSTHOG_MCP_CONNECTOR=posthog/acquisity-foreman-posthog
RESEND_MCP_CONNECTOR=resend/acquisity-foreman-resend
SENTRY_MCP_CONNECTOR=sentry/acquisity-foreman-sentry
STRIPE_MCP_CONNECTOR=stripe/acquisity-foreman-stripe
SUPERMEMORY_MCP_CONNECTOR=mcp.supermemory.ai/acquisity-foreman-supermemory
VERCEL_MCP_CONNECTOR=mcp.vercel.com/acquisity-foreman

# Intercom MCP authenticates with the private Acquisity workspace app token held
# by this app-scoped Vercel Connect API-key connector. It does not use per-user
# consent.
INTERCOM_MCP_CONNECTOR=api.intercom.com/acquisity-foreman-intercom-api

# Lucent MCP authenticates with a static MCP token (created in Lucent
# organization settings) held by a Connect api-key connector.
LUCENT_MCP_CONNECTOR=app.lucenthq.com/acquisity-foreman-lucent

# Inngest Cloud MCP authenticates with an API key (created at
# https://app.inngest.com/mcp/setup) held by a Connect api-key connector,
# created in the Connect dashboard: API Key type, service api.inngest.com/mcp.
INNGEST_MCP_CONNECTOR=api.inngest.com/acquisity-foreman-inngest

# Required app-scoped API-key connectors for every configured intake-only
# channel. These are connector UIDs, not the
# underlying secrets. The Autumn tool has fixed read routes. The Stripe
# connector should hold a restricted read-only key. Missing either value stops
# agent discovery so a deployment cannot silently omit billing evidence.
AUTUMN_API_CONNECTOR=api.useautumn.com/acquisity-foreman-autumn-api
STRIPE_API_CONNECTOR=api.stripe.com/acquisity-foreman-stripe-api

# Required app-scoped API-key connector for read-only Instantly investigation.
# The connector holds the IBG admin-workspace API key; this value is only the
# Vercel Connect UID. Use workspace_group_members:read, accounts:read,
# campaigns:read, and emails:read (or all:read), with no write or *:all scopes.
INSTANTLY_API_CONNECTOR=api.instantly.ai/acquisity-foreman

# Optional app-scoped API-key connector holding a Vercel access token for the
# team, used only by read_foreman_costs to pull the FOCUS billing export
# (GET /v1/billing/charges). The deployment's OIDC token cannot read billing.
# Unset leaves the daily cost report with the AI Gateway side only.
VERCEL_API_CONNECTOR=api.vercel.com/acquisity-foreman-vercel-api

# Foreman's own investigation-memory Postgres (Neon). Pooled connection string,
# server-side only: it never reaches a model message, a tool schema, a tool
# result, or the sandbox. Separate from NEON_MCP_CONNECTOR above, which is the
# user-scoped read-only Neon MCP investigation connection and has nothing to do
# with memory. Apply the schema with `pnpm db:migrate`. Unset means the memory
# tools return `available: false` and triage runs exactly as it does today.
FOREMAN_MEMORY_DATABASE_URL=

# Repository targets are resolved per request, never from deployment config.
# GitHub webhooks bind their signed repository. Linear, Slack, and eve requests
# must carry one explicit owner/repo or GitHub URL.

# Optional Foreman configuration.
# FOREMAN_BOT_NAME=""                 # @mention and commit identity; defaults to the GitHub App slug
# FOREMAN_BRANCH_PREFIX="foreman/"    # feature branches owned by Foreman
# FOREMAN_FACTORY_LABEL="factory"     # trusted GitHub label that activates unattended factory mode
# FOREMAN_REVIEW_BOT_LOGINS=""        # comma-separated lowercase review bot allowlist
# SLACK_INTAKE_ONLY_CHANNELS=""       # comma-separated Slack channel IDs (C.../G.../D...) where mentions can talk and investigate but cannot deliver code

# Base snapshot id for the factory repository warm-up. The `rebuild_warm_snapshot` tool
# produces this id (it clones, installs, and builds the factory repos, then snapshots the
# result); paste the produced id here so the session template starts from the warm
# snapshot. It must be a build-time env var because `source` is fixed at template build
# time. Changing it requires a redeploy to rebuild the template; leave it unset to fall
# back to a cold clone before the first snapshot exists. Rebuild when the warm-up itself
# changes (a new repository, a different install command), not to pick up new commits:
# every session already refreshes the warmed checkout to the remote HEAD.
# VERCEL_SANDBOX_BASE_SNAPSHOT_ID=""
