# Vercel Connect connector UIDs. The deploy button provisions and sets both;
# for manual setup, create them with `vercel connect create` and paste the UIDs.
GITHUB_CONNECTOR=github/foreman-agent
LINEAR_CONNECTOR=linear/foreman-agent

# Personal recall remains user-scoped during the company-service migration.
SUPERMEMORY_MCP_CONNECTOR=mcp.supermemory.ai/acquisity-foreman-supermemory

# Foreman's own investigation-memory Postgres (Neon). Pooled connection string,
# server-side only: it never reaches a model message, a tool schema, a tool
# result, or the sandbox. Separate from the Neon investigation integration in Executor, which has
# nothing to do with Foreman memory. Apply the schema with `pnpm db:migrate`. Unset means the memory
# tools return `available: false` and triage runs exactly as it does today.
FOREMAN_MEMORY_DATABASE_URL=

# Repository targets are resolved per request, never from deployment config.
# GitHub webhooks bind their signed repository. Linear, Slack, and eve requests
# must carry one explicit owner/repo or GitHub URL.

# Optional Foreman configuration.
# FOREMAN_BOT_NAME=""                 # @mention and commit identity; defaults to the GitHub App slug
# FOREMAN_BRANCH_PREFIX="foreman/"    # feature branches owned by Foreman
# FOREMAN_FACTORY_LABEL="factory"     # trusted GitHub label that activates unattended factory mode
# FOREMAN_REVIEW_BOT_LOGINS=""        # comma-separated lowercase review bot allowlist
# SLACK_INTAKE_ONLY_CHANNELS=""       # comma-separated Slack channel IDs (C.../G.../D...) where mentions can talk and investigate but cannot deliver code

# Base snapshot id for the factory repository warm-up. The `rebuild_warm_snapshot` tool
# produces this id (it clones, installs, and builds the factory repos, then snapshots the
# result); paste the produced id here so the session template starts from the warm
# snapshot. It must be a build-time env var because `source` is fixed at template build
# time. Changing it requires a redeploy to rebuild the template; leave it unset to fall
# back to a cold clone before the first snapshot exists. Rebuild when the warm-up itself
# changes (a new repository, a different install command), not to pick up new commits:
# every session already refreshes the warmed checkout to the remote HEAD.
# VERCEL_SANDBOX_BASE_SNAPSHOT_ID=""

# Shared company-service gateway, provisioned before cutover.
EXECUTOR_MCP_CONNECTOR=executor.acquisity.ai/foreman
EXECUTOR_BASE_URL=https://executor.acquisity.ai
# JSON operation bindings from the verified Executor catalog; see EXECUTOR-CONTRACT.md.
EXECUTOR_OPERATION_BINDINGS={}
