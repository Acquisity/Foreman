{
  "name": "foreman-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Foreman, Acquisity's general-purpose eve agent.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "check": "ultracite check",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev": "eve dev",
    "eval": "eve eval",
    "executor:contract": "tsx scripts/executor-contract.ts",
    "executor:readiness": "tsx scripts/executor-readiness.ts",
    "executor:specs": "tsx scripts/executor-linear-specs.ts && biome format --write .github/executor/specs/linear-read.json .github/executor/specs/linear-write.json",
    "fix": "ultracite fix",
    "report:capabilities": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/capability-budget.ts",
    "start": "eve start",
    "test": "tsx --test \"agent/**/*.test.ts\"",
    "typecheck": "tsc",
    "validate": "tsx scripts/executor-linear-specs.ts --check && pnpm run check && pnpm run typecheck && eve info && pnpm run test",
    "verify:built-github": "tsx scripts/verify-built-github.mjs"
  },
  "dependencies": {
    "@agent-browser/eve": "0.37.1",
    "@github-tools/eve-extension": "0.7.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/connect": "0.8.0",
    "@vercel/sandbox": "^3.0.0",
    "ai": "7.0.97",
    "eve": "0.54.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "~24.13.3",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "ultracite": "^7.10.2"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "24.x"
  }
}
