{
  "name": "foreman-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Foreman, Acquisity's general-purpose eve agent with an optional software factory mode.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "check": "ultracite check",
    "dev": "eve dev",
    "eval": "eve eval",
    "fix": "ultracite fix",
    "start": "eve start",
    "test": "tsx --test \"agent/**/*.test.ts\"",
    "typecheck": "tsc",
    "validate": "pnpm run check && pnpm run typecheck && pnpm run test && eve info"
  },
  "dependencies": {
    "@agent-browser/eve": "^0.34.0",
    "@github-tools/eve-extension": "^0.3.2",
    "@vercel/blob": "^2.8.0",
    "@vercel/connect": "0.8.0",
    "@vercel/sandbox": "^3.0.0",
    "ai": "^7.0.63",
    "eve": "^0.44.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "~24.13.3",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "ultracite": "^7.10.2"
  },
  "engines": {
    "node": "24.x"
  }
}
