{
  "openapi": "3.0.3",
  "info": {
    "title": "Foreman Linear write API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.linear.app"
    }
  ],
  "paths": {
    "/graphql": {
      "post": {
        "operationId": "executeForemanWrite",
        "summary": "Only exact authored Foreman write operations. No arbitrary GraphQL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query", "variables"],
                "additionalProperties": false,
                "properties": {
                  "query": {
                    "type": "string",
                    "enum": [
                      "mutation CreateDocument($input: DocumentCreateInput!) {\n  documentCreate(input: $input) { success document { id updatedAt url } }\n}",
                      "mutation UpdateDocument($id: String!, $input: DocumentUpdateInput!) {\n  documentUpdate(id: $id, input: $input) { success document { id updatedAt url } }\n}",
                      "mutation RouteIssueUpdate($id: String!, $input: IssueUpdateInput!) {\n  issueUpdate(id: $id, input: $input) { success }\n}",
                      "mutation RouteRelation($input: IssueRelationCreateInput!) {\n  issueRelationCreate(input: $input) { success }\n}",
                      "mutation RouteAttachment($issueId: String!, $url: String!, $title: String!) {\n  attachmentLinkURL(issueId: $issueId, url: $url, title: $title) { success }\n}"
                    ]
                  },
                  "variables": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Linear GraphQL response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
