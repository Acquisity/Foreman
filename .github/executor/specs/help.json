{
  "openapi": "3.0.3",
  "info": {
    "title": "Foreman help-center search",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://app.acquisity.ai"
    }
  ],
  "paths": {
    "/api/search": {
      "get": {
        "operationId": "searchHelpCenter",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
